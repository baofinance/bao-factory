# Copy to .env and fill in your values.
# Foundry loads .env from the project root automatically.

# Etherscan API key (mainnet, Arbitrum, Base)
ETHERSCAN_KEY=

# Etherscan API key (MegaETH, Monad)
ETHERSCAN_API_KEY=

# RPC endpoints (foundry.toml [rpc_endpoints])
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
MEGAETH_RPC_URL=
MONAD_RPC_URL=

# Explorer API URLs (MegaETH, Monad)
MEGAETH_ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
MONAD_ETHERSCAN_API_URL=https://api.etherscan.io/v2/api

# Optional: wait up to N seconds for contract verification (script/bao-factory)
# BAO_FACTORY_VERIFY_WAIT=120
